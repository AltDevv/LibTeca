<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/>
	</parent>

	<groupId>com.libteca</groupId>
	<artifactId>backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>

	<properties>
		<java.version>17</java.version>
        <testes.excluidos>playwright</testes.excluidos>
        <testes.fontes>${project.basedir}/src/test/java</testes.fontes>
        <testes.classes>${project.basedir}/target/test-classes</testes.classes>
        <testes.relatorios>${project.basedir}/target/surefire-reports</testes.relatorios>
	</properties>

	<dependencies>

		<dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.2.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

		<!-- Spring Security: autenticação, autorização, roles e proteção dos endpoints -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- Lombok: reduz código repetitivo como getters, setters e construtores -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>1.18.46</version>
			<scope>provided</scope>
		</dependency>

		<!-- MySQL: driver JDBC para conectar o LibTeca ao banco MySQL -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- SQLite: driver JDBC para usar banco local em arquivo .db -->
		<dependency>
			<groupId>org.xerial</groupId>
			<artifactId>sqlite-jdbc</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Hibernate SQLite Dialect: permite ao Hibernate gerar SQL compatível com SQLite -->
		<dependency>
			<groupId>org.hibernate.orm</groupId>
			<artifactId>hibernate-community-dialects</artifactId>
		</dependency>

		<!-- H2 Console: interface web para visualizar e consultar bancos H2 durante o desenvolvimento -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-h2console</artifactId>
		</dependency>

		<!-- Spring Data JPA: repositories, JPA e integração com Hibernate -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Validation: anotações de validação como @NotNull, @NotBlank, @Email e @Size -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Spring Web MVC: controllers REST, endpoints HTTP, JSON e funcionamento da API web -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- H2 Database: banco em memória/arquivo usado em testes e desenvolvimento local -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Testes do Spring Data JPA: suporte para testar repositories e persistência -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Testes de validação: suporte para testar regras do Jakarta Validation -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Testes do Spring Web MVC: suporte para testar controllers e endpoints HTTP -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<build>
        <testSourceDirectory>${testes.fontes}</testSourceDirectory>
        <testOutputDirectory>${testes.classes}</testOutputDirectory>

		<plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${testes.excluidos}</excludedGroups>
                    <reportsDirectory>${testes.relatorios}</reportsDirectory>
                </configuration>
            </plugin>

            <!-- Copia as telas no build sem tornar frontEnd uma raiz de recursos do módulo Java. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copiar-front-end</id>
                        <phase>process-resources</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../frontEnd</directory>
                                    <filtering>false</filtering>
                                    <includes>
                                        <include>index.html</include><include>css/**</include><include>assets/**</include>
                                        <include>config/**</include><include>controller/**</include><include>dto/**</include>
                                        <include>entity/**</include><include>enums/**</include><include>filter/**</include>
                                        <include>handler/**</include><include>mapper/**</include><include>repository/**</include>
                                        <include>service/**</include><include>specification/**</include><include>telas/**</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>


			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>1.18.46</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

		</plugins>
	</build>
    <profiles>
        <profile>
            <id>front-playwright</id>
            <properties>
                <testes.excluidos>nenhum</testes.excluidos>
                <testes.fontes>${project.basedir}/../frontEnd/tests/playwright</testes.fontes>
                <testes.classes>${project.basedir}/../frontEnd/target/test-classes</testes.classes>
                <testes.relatorios>${project.basedir}/../frontEnd/target/surefire-reports</testes.relatorios>
                <testes.evidencias>${project.basedir}/../frontEnd/target/playwright</testes.evidencias>
            </properties>
            <dependencies><dependency>
                <groupId>com.microsoft.playwright</groupId>
                <artifactId>playwright</artifactId>
                <version>1.64.0</version>
                <scope>test</scope>
            </dependency></dependencies>
            <build>
                <plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <groups>playwright</groups>
                    <reportsDirectory>${testes.relatorios}</reportsDirectory>
                    <systemPropertyVariables>
                        <playwright.output>${testes.evidencias}</playwright.output>
                    </systemPropertyVariables>
                    <argLine>"-javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar"</argLine>
                </configuration>
            </plugin></plugins></build>
        </profile>
    </profiles>
</project>
